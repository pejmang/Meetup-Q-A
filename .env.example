# Copy to .env and edit
ADMIN_PASSWORD=change-me-at-least-8-chars
# Host port (bound to 127.0.0.1, put a reverse proxy in front)
HOST_PORT=3000
# Sub-path when served under e.g. https://example.com/v2.0/ (leave empty at the root)
BASE_PATH=
# 1 = trust X-Real-IP / X-Forwarded-For from the reverse proxy (needed for per-IP rate limiting)
TRUST_PROXY=1
# Public demo event codes that reset automatically (comma-separated, e.g. K4ARN); empty = none
DEMO_RESET_EVENTS=
DEMO_RESET_MIN=30
# Google OAuth Web client ID: enables self-service registration (/register); empty = disabled
GOOGLE_CLIENT_ID=
MAX_SPACES_PER_EMAIL=3
# Demo event linked from the home page (empty = no demo card)
PUBLIC_DEMO_URL=
# Several demos on the home page: Title|URL;Title|URL
PUBLIC_DEMOS=
# Public address of the website (canonical links, sitemap, llms.txt); derived from the request when empty
SITE_URL=
# Set to 1 on a test or staging site to keep it out of search engines
SITE_NOINDEX=
